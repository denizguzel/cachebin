{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cachebin",
  "version": "0.1.0",
  "identifier": "com.cachebin.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cachebin",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Cachebin",
    "shortDescription": "Safe cache and build artifact cleanup for developers",
    "longDescription": "Cachebin scans Windows and WSL2 developer caches, project build artifacts and large files, and moves them to Trash after review.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
